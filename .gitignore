# Dependencies
node_modules/
.venv/
__pycache__/

# Build / cache
.next/
out/
build/
artifacts/
*.tsbuildinfo

# Ảnh avatar do người dùng upload lúc chạy, không phải asset của repo
backend/static/avatars/*
!backend/static/avatars/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env (secrets)
.env*
!.env.example

# Certificates and private keys must be provisioned outside Git
certs/*.crt
certs/*.key
certs/*.pem
!certs/README.md

# OS
.DS_Store

# Database
*.db
*.sqlite
*.sqlite3
