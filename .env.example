# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Backend Configuration
# Database
# Use 'db' as host when running via docker-compose
POSTGRES_PASSWORD=CHANGE-THIS-DATABASE-PASSWORD
DATABASE_URL=postgresql+asyncpg://admin:CHANGE-THIS-DATABASE-PASSWORD@db:5432/happy_schools
DATABASE_URL_SYNC=postgresql://admin:CHANGE-THIS-DATABASE-PASSWORD@db:5432/happy_schools

# App
APP_NAME=Happy Schools API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
TRUSTED_PROXY_HOSTS=["127.0.0.1", "::1"]

# JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["https://schoolmanager.id.vn", "http://localhost:3000", "http://127.0.0.1:3000"]

# EMAIL
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
