# Frontend
NEXT_PUBLIC_API_URL=https://api.schoolmanager.id.vn

# Backend Configuration
# Database
# Use 'db' as host when running via docker-compose
DATABASE_URL=postgresql+asyncpg://admin:YOUR_DB_PASSWORD@db:5432/happy_schools
DATABASE_URL_SYNC=postgresql://admin:YOUR_DB_PASSWORD@db:5432/happy_schools

# App
APP_NAME=Happy Schools API
APP_VERSION=1.0.0
DEBUG=false

# JWT
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["https://schoolmanager.id.vn", "http://localhost:3000", "http://127.0.0.1:3000"]

# EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
