# Frontend public API URL (inlined during the Next.js build)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Docker Compose database. Replace before running Compose.
POSTGRES_PASSWORD=CHANGE-THIS-DATABASE-PASSWORD

# Backend runtime
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
TRUSTED_PROXY_HOSTS=["127.0.0.1", "::1"]

# JWT. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated or JSON-list origins are accepted.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Optional SMTP configuration. Leave credentials blank when email is disabled.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
